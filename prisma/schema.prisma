generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PotType {
  ESSENTIAL
  DEBT_RESCUE
  FREEDOM_INVEST
  LIFESTYLE
  SHORT_GOAL
}

enum TransactionType {
  INCOME
  EXPENSE
  INVESTMENT
}

enum TransactionSource {
  MANUAL
  AI_CHAT
  OFX_CSV
  WHATSAPP
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  passwordHash        String?
  phone               String?            @unique
  role                UserRole           @default(USER)
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  subscriptionPlan    String             @default("MENSAL_PRO")
  subscriptionEndsAt  DateTime?
  
  // Perfil Financeiro Dinâmico
  monthlyIncome       Float              @default(3500)
  payday              Int                @default(5)
  essentialFixedCosts Float              @default(2100)
  currentInvested     Float              @default(1200)
  totalDebt           Float              @default(0)
  monthlyDebtPayment  Float              @default(0)
  targetMonthlyIncome Float              @default(3500)
  annualRealYield     Float              @default(0.06) // 6% real acima da inflação (regra de retirada segura)
  maturityLevel       Int                @default(1)    // 1 a 5

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  pots                Pot[]
  transactions        Transaction[]
  debts               Debt[]
  advisorMessages     AdvisorMessage[]
}

model Pot {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         PotType
  percentage   Float         // % do salário alocado
  targetAmount Float         // Valor mensal planejado em R$
  spentAmount  Float         @default(0)
  color        String        @default("#10b981")
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  potId       String?
  pot         Pot?              @relation(fields: [potId], references: [id], onDelete: SetNull)
  description String
  amount      Float
  type        TransactionType   @default(EXPENSE)
  category    String            @default("Geral")
  source      TransactionSource @default(MANUAL)
  date        DateTime          @default(now())
  createdAt   DateTime          @default(now())
}

model Debt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  totalBalance   Float
  monthlyPayment Float
  interestRate   Float    @default(0) // % ao mês
  isPaid         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model AdvisorMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "system"
  content   String
  actionTag String?  // Ex: "TRANSACTION_ADDED", "BUDGET_REBALANCED"
  createdAt DateTime @default(now())
}
